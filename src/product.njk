---
layout: base.njk
pagination:
  data: collections.products
  size: 1
  alias: product
permalink: "/shop/{{ product.data.slug }}/"
eleventyComputed:
  pageTitle: "{{ product.data.title }} — Dekoris"
  pageDescription: "{{ product.data.description }}"
  activePage: shop
---
  <style>
    .product-detail-hero {
      margin-top: 80px; padding: 80px 40px 56px;
      background: var(--white);
    }
    .product-detail-inner {
      max-width: 1180px; margin: 0 auto;
      display: grid; grid-template-columns: 1.05fr 1fr; gap: 64px;
      align-items: start;
    }
    .product-detail-media img.pd-main {
      width: 100%; border-radius: 12px; display: block;
      aspect-ratio: 4 / 5; object-fit: cover; background: var(--cream);
    }
    .product-photo-strip {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 10px; margin-top: 10px;
    }
    .product-photo-strip img {
      width: 100%; aspect-ratio: 4 / 3; object-fit: cover;
      border-radius: 6px; display: block; cursor: pointer; opacity: 0.85;
    }
    .product-photo-strip img:hover { opacity: 1; }
    .product-detail-content .section-label { margin-bottom: 12px; }
    .product-detail-content h1 {
      font-family: var(--font-heading);
      font-size: var(--type-h1);
      font-weight: 500; color: var(--text-dark);
      line-height: 1.15; margin-bottom: 10px;
    }
    .pd-from { font-size: 14px; color: var(--text-light); margin-bottom: 20px; letter-spacing: 0.5px; }
    .pd-from b { color: var(--text-dark); font-size: 19px; font-weight: 500; }
    .product-detail-content .lead {
      font-size: 15px; color: var(--text-body); line-height: 1.7;
      margin-bottom: 24px;
    }
    .product-meta-row {
      display: flex; flex-wrap: wrap; gap: 16px 28px;
      margin: 16px 0 8px;
      padding: 16px 0;
      border-top: 1px solid var(--cream-dark);
      border-bottom: 1px solid var(--cream-dark);
    }
    .product-meta { font-size: 13px; color: var(--text-body); }
    .product-meta strong {
      display: block;
      font-size: 11px; letter-spacing: 1.2px;
      text-transform: uppercase; color: var(--text-light);
      font-weight: 500; margin-bottom: 2px;
    }
    .best-suited {
      margin: 20px 0 8px;
      padding: 18px 22px;
      background: var(--cream);
      border-left: 3px solid var(--gold);
      border-radius: 4px;
    }
    .best-suited strong {
      font-family: var(--font-body); font-size: 12px;
      letter-spacing: 1.5px; text-transform: uppercase;
      color: var(--gold-dark); font-weight: 500;
      display: block; margin-bottom: 6px;
    }
    .best-suited p { font-size: 14px; color: var(--text-body); line-height: 1.65; margin: 0; }
    .catalogue-link { color: var(--text-body); border-bottom: 1px solid var(--gold); font-weight: 500; }
    .catalogue-link:hover { color: var(--gold-dark); }

    /* ═══ Configurator ═══ */
    .cfg-step {
      font-size: 11px; letter-spacing: 2.2px; text-transform: uppercase;
      color: var(--text-dark); font-weight: 600; margin: 26px 0 12px;
    }
    .cfg-step em { font-style: normal; color: var(--gold-dark); font-weight: 500; letter-spacing: 0.3px; text-transform: none; }
    .fabric-toggle { display: flex; width: fit-content; border: 1px solid var(--cream-dark); }
    .fabric-toggle button {
      border: none; background: var(--white); padding: 10px 22px;
      font-family: var(--font-body); font-size: 11px; letter-spacing: 1.8px;
      text-transform: uppercase; cursor: pointer; color: var(--text-light);
    }
    .fabric-toggle button.on { background: var(--charcoal); color: var(--white); }
    .swatch-row { display: flex; flex-wrap: wrap; gap: 12px; }
    .swatch { width: 48px; cursor: pointer; text-align: center; }
    .swatch .sw-tile {
      height: 48px; border-radius: 50%;
      box-shadow: inset 0 0 0 1px rgba(0,0,0,0.08);
      border: 2px solid var(--white);
      outline: 1px solid transparent;
      position: relative; overflow: hidden;
    }
    .swatch.linen .sw-tile::after {
      content: ""; position: absolute; inset: 0; border-radius: 50%;
      background-image: repeating-linear-gradient(45deg, rgba(255,255,255,0.16) 0 1px, transparent 1px 3px),
                        repeating-linear-gradient(-45deg, rgba(0,0,0,0.06) 0 1px, transparent 1px 3px);
    }
    .swatch.on .sw-tile { outline-color: var(--charcoal); }
    .swatch span {
      font-size: 8.5px; letter-spacing: 0.4px; color: var(--text-light);
      display: block; margin-top: 5px; line-height: 1.3;
    }
    .size-chips { display: flex; flex-wrap: wrap; gap: 8px; }
    .size-chip {
      border: 1px solid var(--cream-dark); background: var(--white);
      padding: 10px 16px; font-size: 12px; letter-spacing: 0.8px;
      cursor: pointer; color: var(--text-body);
    }
    .size-chip.on { border-color: var(--charcoal); background: var(--charcoal); color: var(--white); }
    .cfg-buy { display: flex; gap: 10px; margin-top: 28px; align-items: stretch; }
    .cfg-qty { display: flex; align-items: center; border: 1px solid var(--cream-dark); background: var(--white); }
    .cfg-qty button {
      border: none; background: none; font-size: 17px; padding: 0 15px;
      cursor: pointer; color: var(--text-dark); height: 100%;
    }
    .cfg-qty span { min-width: 28px; text-align: center; font-size: 14px; }
    .add-order-btn {
      flex: 1; background: none; border: 1px solid var(--charcoal);
      color: var(--charcoal); padding: 15px;
      font-family: var(--font-body); font-size: 12px; letter-spacing: 2.5px;
      text-transform: uppercase; cursor: pointer; transition: 0.2s;
    }
    .add-order-btn:hover { background: var(--charcoal); color: var(--white); }
    .cfg-note { font-size: 12px; color: var(--text-light); margin-top: 12px; line-height: 1.6; }
    .cfg-hint { font-size: 11.5px; color: var(--text-light); margin-top: 8px; line-height: 1.5; }
    .cfg-choice { flex-wrap: wrap; }

    /* Legacy size rows (products without swatch data yet) */
    .sizes-heading {
      font-family: var(--font-heading); font-size: 14px;
      letter-spacing: 1.5px; text-transform: uppercase;
      color: var(--text-light); font-weight: 500;
      margin: 24px 0 16px;
    }
    .size-options { display: flex; flex-direction: column; gap: 12px; margin-bottom: 24px; }
    .size-option {
      display: grid; grid-template-columns: 1fr auto; gap: 16px;
      align-items: center; padding: 18px 22px;
      background: var(--cream); border-radius: 8px;
      transition: background 0.2s;
    }
    .size-option:hover { background: var(--cream-dark); }
    .size-name { font-family: var(--font-body); font-size: 15px; font-weight: 500; color: var(--text-dark); }
    .size-label {
      font-size: 11px; color: var(--text-light); display: block; font-weight: 400;
      letter-spacing: 0.5px; text-transform: uppercase; margin-bottom: 2px;
    }
    .size-enquire {
      padding: 12px 22px; background: var(--charcoal); color: var(--white);
      border: none; border-radius: 4px;
      font-family: var(--font-body); font-size: 12px; font-weight: 500;
      letter-spacing: 1.2px; text-transform: uppercase; cursor: pointer;
      text-decoration: none; display: inline-block; text-align: center; white-space: nowrap;
      transition: background 0.2s;
    }
    .size-enquire:hover { background: var(--charcoal-deep); color: var(--white); }

    .custom-size-exit {
      margin-top: 20px; padding: 22px;
      background: var(--cream); border-radius: 8px;
      border-left: 3px solid var(--gold);
      font-size: 14px; color: var(--text-body); line-height: 1.6;
    }
    .custom-size-exit strong { display: block; color: var(--text-dark); font-weight: 500; margin-bottom: 4px; }
    .custom-size-exit a { color: var(--text-dark); border-bottom: 1px solid var(--gold); font-weight: 500; }
    .custom-size-exit a:hover { color: var(--gold); }

    .back-to-shop { max-width: 1180px; margin: 0 auto; padding: 40px 40px 0; font-size: 13px; }
    .back-to-shop a { color: var(--text-light); letter-spacing: 0.5px; }
    .back-to-shop a:hover { color: var(--gold); }

    .signature-panels { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 24px 0; }
    .sig-panel {
      display: block; padding: 20px 22px;
      background: var(--cream); border-radius: 8px;
      border-left: 3px solid var(--gold);
      text-decoration: none; color: inherit;
      transition: transform 0.2s, background 0.2s;
    }
    .sig-panel:hover { transform: translateY(-2px); background: var(--cream-dark); }
    .sig-panel h4 { font-family: var(--font-heading); font-size: 15px; font-weight: 500; color: var(--text-dark); margin-bottom: 6px; }
    .sig-panel p { font-size: 13px; color: var(--text-body); line-height: 1.6; margin-bottom: 10px; }
    .sig-link {
      font-size: 11px; letter-spacing: 1px; text-transform: uppercase;
      color: var(--gold-dark); font-weight: 500;
      border-bottom: 1px solid var(--gold-light); padding-bottom: 1px;
    }
    @media (max-width: 900px) {
      .signature-panels { grid-template-columns: 1fr; }
      .product-detail-inner { grid-template-columns: 1fr; gap: 32px; }
      .product-detail-hero { padding: 64px 24px 48px; }
      .back-to-shop { padding: 24px 24px 0; }
    }
  </style>

  <div class="back-to-shop">
    <a href="/shop/">← Back to Shop</a>
  </div>

  <section class="product-detail-hero">
    <div class="product-detail-inner">
      <div class="product-detail-media">
        <img class="pd-main" id="pdMain" src="{{ product.data.image }}" alt="{{ product.data.title }}">
        {% if product.data.photos %}
        <div class="product-photo-strip">
          {% for photo in product.data.photos %}
          <img src="{{ photo.src }}" alt="{{ photo.alt }}" loading="lazy" onclick="document.getElementById('pdMain').src = this.src">
          {% endfor %}
        </div>
        {% endif %}
      </div>

      <div class="product-detail-content">
        <div class="section-label">{{ product.data.category }}</div>
        <h1>{{ product.data.title }}</h1>
        {% if product.data.priceNote %}
        <div class="pd-from"><b>{{ product.data.priceNote }}</b> · final price confirmed in your free quote</div>
        {% else %}
        <div class="pd-from">from <b>N${{ product.data.price | commaNumber }}</b> · final price confirmed in your free quote</div>
        {% endif %}
        <p class="lead">{{ product.data.longDescription or product.data.description }}</p>

        {% if product.data.bestSuitedFor %}
        <div class="best-suited">
          <strong>Best suited for:</strong>
          <p>{{ product.data.bestSuitedFor }}</p>
        </div>
        {% endif %}

        <div class="product-meta-row">
          {% if (product.data.colours and product.data.colours.length and not product.data.fabricTypes) or product.data.colourCatalogue %}
          <div class="product-meta">
            <strong>Colours</strong>
            {% if product.data.colours and product.data.colours.length and not product.data.fabricTypes %}{{ product.data.colours | join(" · ") }} · {% endif %}<a href="mailto:hello@dekoris.com.na?subject=Colour%20catalogue%20request&body=Hi%20Dekoris%2C%20please%20send%20me%20the%20full%20colour%20and%20fabric%20catalogue." class="catalogue-link">View colour catalogue</a>
          </div>
          {% endif %}
          {% if product.data.control %}
          <div class="product-meta">
            <strong>Control</strong>
            {{ product.data.control }}
          </div>
          {% elif product.data.motorised %}
          <div class="product-meta">
            <strong>Control</strong>
            Cordless · Corded · Motorised
          </div>
          {% endif %}
          <div class="product-meta">
            <strong>Installation</strong>
            No-Drill or Permanent
          </div>
        </div>

        {% if product.data.fabricTypes %}
        <!-- ═══ Configurator ═══ -->
        <div class="cfg-step">1 · Fabric type</div>
        <div class="fabric-toggle" id="cfgFabric"></div>

        <div class="cfg-step">2 · Colour — <em id="cfgColourName"></em></div>
        <div class="swatch-row" id="cfgSwatches"></div>

        <div class="cfg-step">3 · Approximate size</div>
        <div class="size-chips" id="cfgSizes">
          {% for size in product.data.sizes %}
          <div class="size-chip{% if loop.first %} on{% endif %}" data-price="{{ size.price }}">{{ size.name }}</div>
          {% endfor %}
          <div class="size-chip" data-price="">Custom — we measure</div>
        </div>

        <div class="cfg-step">4 · Installation</div>
        <div class="fabric-toggle cfg-choice" id="cfgInstall">
          <button type="button" data-v="No-Drill (tension fit)">No-Drill</button>
          <button type="button" data-v="Drilled (permanent)">Drilled</button>
          <button type="button" class="on" data-v="Not sure — please advise">Not sure</button>
        </div>
        <div class="cfg-hint">No-Drill uses tension brackets — no holes, no damage. Ideal for rentals.</div>

        <div class="cfg-step">5 · Operation</div>
        <div class="fabric-toggle cfg-choice" id="cfgOperation">
          <button type="button" data-v="Corded / Cordless">Corded / Cordless</button>
          {% if product.data.motorised %}<button type="button" data-v="Motorised">Motorised</button>{% endif %}
          <button type="button" class="on" data-v="Not sure — please advise">Not sure</button>
        </div>

        <div class="cfg-buy">
          <div class="cfg-qty">
            <button type="button" onclick="cfgQty(-1)">−</button><span id="cfgQtyVal">1</span><button type="button" onclick="cfgQty(1)">+</button>
          </div>
          <button type="button" class="add-order-btn" onclick="cfgAdd()">Add to Cart</button>
        </div>
        <div class="cfg-note">No payment is taken online. Your selection becomes an invoice request — we confirm colours against physical samples, measure your windows, and finalise your invoice before manufacture.</div>

        <script>
          window.CFG_PRODUCT = {
            title: {{ product.data.title | dump | safe }},
            slug: {{ product.data.slug | dump | safe }},
            fabricTypes: {{ product.data.fabricTypes | dump | safe }}
          };
        </script>
        {% else %}
        <!-- Legacy: sizes with Enquire (colour swatches coming when the colour book arrives) -->
        <div class="sizes-heading">Standard Sizes</div>
        <div class="size-options">
          {% for size in product.data.sizes %}
          <div class="size-option">
            <div>
              <span class="size-label">{{ product.data.title }}</span>
              <span class="size-name">{{ size.name }}</span>
            </div>
            <a class="size-enquire" href="/quote/?product={{ product.data.slug }}&size={{ size.sku }}">Enquire</a>
          </div>
          {% endfor %}
        </div>
        {% endif %}

        {% if product.data.slug != "curtains" %}
        <div class="signature-panels">
          <a class="sig-panel" href="/no-drill/">
            <h4>No-Drill installation available</h4>
            <p>Zero wall damage. Ideal for renters and complexes. Same finish as a drilled install.</p>
            <span class="sig-link">How No-Drill works →</span>
          </a>
          <a class="sig-panel" href="/motorised/">
            <h4>Available with motorisation</h4>
            <p>Remote, wall switch, or smart-home control. Perfect for large windows and multi-window rooms.</p>
            <span class="sig-link">How motorisation works →</span>
          </a>
        </div>
        {% endif %}

        <div class="custom-size-exit">
          <strong>Window a different size?</strong>
          Most Namibian windows fit one of the standard sizes above. For anything custom — odd shapes, larger drops, bay windows — <a href="/quote/?product={{ product.data.slug }}">request a free measurement and quote</a>. We visit, measure, and email a fully-itemised quote within a few working days.
        </div>
      </div>
    </div>
  </section>

<!-- Cart drawer is included site-wide via base.njk -->
