---
layout: base.njk
pagination:
  data: collections.products
  size: 1
  alias: product
permalink: "/shop/{{ product.data.slug }}/"
eleventyComputed:
  pageTitle: "{{ product.data.title }} — Dekoris"
  pageDescription: "{{ product.data.description }}"
  activePage: shop
---
  <style>
    .product-detail-hero {
      margin-top: 80px; padding: 80px 40px 56px;
      background: var(--white);
    }
    .product-detail-inner {
      max-width: 1180px; margin: 0 auto;
      display: grid; grid-template-columns: 1.05fr 1fr; gap: 64px;
      align-items: start;
    }
    .product-detail-media {
      border-radius: 12px; overflow: hidden;
      background: var(--cream);
      aspect-ratio: 4 / 5;
    }
    .product-detail-media img {
      width: 100%; height: 100%; object-fit: cover;
    }
    .product-detail-content .section-label { margin-bottom: 12px; }
    .product-detail-content h1 {
      font-family: var(--font-heading);
      font-size: clamp(32px, 4vw, 44px);
      font-weight: 500; color: var(--text-dark);
      line-height: 1.15; margin-bottom: 16px;
    }
    .product-detail-content .lead {
      font-size: 16px; color: var(--text-body); line-height: 1.7;
      margin-bottom: 28px;
    }
    .product-meta-row {
      display: flex; flex-wrap: wrap; gap: 16px 28px;
      margin: 20px 0 32px;
      padding: 16px 0;
      border-top: 1px solid var(--cream-dark);
      border-bottom: 1px solid var(--cream-dark);
    }
    .product-meta { font-size: 13px; color: var(--text-body); }
    .product-meta strong {
      display: block;
      font-size: 11px; letter-spacing: 1.2px;
      text-transform: uppercase; color: var(--text-light);
      font-weight: 500; margin-bottom: 2px;
    }

    .sizes-heading {
      font-family: var(--font-heading); font-size: 14px;
      letter-spacing: 1.5px; text-transform: uppercase;
      color: var(--text-light); font-weight: 500;
      margin-bottom: 16px;
    }
    .size-options {
      display: flex; flex-direction: column; gap: 12px;
      margin-bottom: 24px;
    }
    .size-option {
      display: grid; grid-template-columns: 1fr auto auto; gap: 16px;
      align-items: center;
      padding: 18px 22px;
      background: var(--cream);
      border-radius: 8px;
      transition: background 0.2s, transform 0.2s;
    }
    .size-option:hover { background: var(--cream-dark); }
    .size-name {
      font-family: var(--font-body); font-size: 15px;
      font-weight: 500; color: var(--text-dark);
    }
    .size-label {
      font-size: 11px; color: var(--text-light);
      display: block; font-weight: 400;
      letter-spacing: 0.5px; text-transform: uppercase;
      margin-bottom: 2px;
    }
    .size-price {
      font-size: 16px; font-weight: 500; color: var(--text-dark);
      min-width: 92px; text-align: right;
    }
    .size-enquire {
      padding: 12px 22px;
      background: var(--charcoal); color: var(--white);
      border: none; border-radius: 6px;
      font-family: var(--font-body); font-size: 12px;
      font-weight: 500; letter-spacing: 1.2px;
      text-transform: uppercase; cursor: pointer;
      transition: background 0.2s, transform 0.2s;
      text-decoration: none; display: inline-block;
      text-align: center; white-space: nowrap;
    }
    .size-enquire:hover { background: var(--charcoal-deep); transform: translateY(-1px); color: var(--white); }

    .custom-size-exit {
      margin-top: 8px; padding: 22px;
      background: var(--cream); border-radius: 8px;
      border-left: 3px solid var(--gold);
      font-size: 14px; color: var(--text-body); line-height: 1.6;
    }
    .custom-size-exit strong {
      display: block; color: var(--text-dark);
      font-weight: 500; margin-bottom: 4px;
    }
    .custom-size-exit a {
      color: var(--text-dark); border-bottom: 1px solid var(--gold);
      font-weight: 500;
    }
    .custom-size-exit a:hover { color: var(--gold); }

    .back-to-shop {
      max-width: 1180px; margin: 0 auto;
      padding: 40px 40px 0;
      font-size: 13px;
    }
    .back-to-shop a { color: var(--text-light); letter-spacing: 0.5px; }
    .back-to-shop a:hover { color: var(--gold); }


    .signature-panels {
      display: grid; grid-template-columns: 1fr 1fr; gap: 12px;
      margin: 24px 0;
    }
    .sig-panel {
      display: block; padding: 20px 22px;
      background: var(--cream); border-radius: 8px;
      border-left: 3px solid var(--gold);
      text-decoration: none; color: inherit;
      transition: transform 0.2s, background 0.2s;
    }
    .sig-panel:hover { transform: translateY(-2px); background: var(--cream-dark); }
    .sig-panel h4 {
      font-family: var(--font-heading);
      font-size: 15px; font-weight: 500;
      color: var(--text-dark); margin-bottom: 6px;
    }
    .sig-panel p {
      font-size: 13px; color: var(--text-body);
      line-height: 1.6; margin-bottom: 10px;
    }
    .sig-link {
      font-size: 11px; letter-spacing: 1px;
      text-transform: uppercase;
      color: var(--gold-dark); font-weight: 500;
      border-bottom: 1px solid var(--gold-light);
      padding-bottom: 1px;
    }
    @media (max-width: 900px) {
      .signature-panels { grid-template-columns: 1fr; }
    }

    @media (max-width: 900px) {
      .product-detail-inner { grid-template-columns: 1fr; gap: 32px; }
      .product-detail-hero { padding: 64px 24px 48px; }
      .back-to-shop { padding: 24px 24px 0; }
      .size-option { grid-template-columns: 1fr auto; }
      .size-enquire { grid-column: 1 / -1; }
      .size-price { text-align: left; }
    }
  </style>

  <div class="back-to-shop">
    <a href="/shop/">← Back to Shop</a>
  </div>

  <section class="product-detail-hero">
    <div class="product-detail-inner">
      <div class="product-detail-media fade-up">
        <img src="{{ product.data.image }}" alt="{{ product.data.title }}">
      </div>

      <div class="product-detail-content fade-up" style="transition-delay: 0.08s">
        <div class="section-label">{{ product.data.category }}</div>
        <h1>{{ product.data.title }}</h1>
        <p class="lead">{{ product.data.longDescription or product.data.description }}</p>

        <div class="product-meta-row">
          {% if product.data.colours and product.data.colours.length %}
          <div class="product-meta">
            <strong>Colours</strong>
            {{ product.data.colours | join(" · ") }}
          </div>
          {% endif %}
          {% if product.data.motorised %}
          <div class="product-meta">
            <strong>Control</strong>
            Cordless · Manual · Motorised
          </div>
          {% endif %}
          <div class="product-meta">
            <strong>Installation</strong>
            No-Drill or Permanent
          </div>
        </div>

        <div class="sizes-heading">Standard Sizes</div>
        <div class="size-options">
          {% for size in product.data.sizes %}
          <div class="size-option">
            <div>
              <span class="size-label">{{ size.name }}</span>
              <div class="size-name">{{ product.data.title }}</div>
            </div>
            <div class="size-price">N${{ size.price | commaNumber }}</div>
            <a class="size-enquire" href="/quote/?product={{ product.data.slug }}&size={{ size.sku }}">Enquire</a>
          </div>
          {% endfor %}
        </div>

        {% if product.data.slug != "curtains" %}
        <div class="signature-panels">
          <a class="sig-panel" href="/no-drill/">
            <h4>No-Drill installation available</h4>
            <p>Zero wall damage. Ideal for renters and complexes. Same finish as a drilled install.</p>
            <span class="sig-link">How No-Drill works →</span>
          </a>
          <a class="sig-panel" href="/motorised/">
            <h4>Available with motorisation</h4>
            <p>Remote, wall switch, or smart-home control. Perfect for large windows and multi-window rooms.</p>
            <span class="sig-link">How motorisation works →</span>
          </a>
        </div>
        {% endif %}

        <div class="custom-size-exit">
          <strong>Window a different size?</strong>
          Most Namibian windows fit one of the three standard sizes above. For anything custom — odd shapes, larger drops, bay windows — <a href="/quote/?product={{ product.data.slug }}">request a free measurement and quote</a>. We visit, measure, and email a fully-itemised quote within a few working days.
        </div>
      </div>
    </div>
  </section>
