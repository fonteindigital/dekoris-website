  <!-- ═══════════ HERO ═══════════ -->
  <section class="hero">
    <div class="hero-image"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <h1>Crafting Beautiful Spaces</h1>
      <p>Blinds, window treatments and curtains, that elevate the beauty of your home and office. Proudly Namibian.</p>
      <div class="hero-buttons">
        <a href="/quote/" class="btn btn-gold">Request a Quote</a>
        <a href="/about/" class="btn btn-outline">Learn More</a>
      </div>
    </div>
  </section>

  <!-- ═══════════ SIGNATURE FEATURES (Slice 12) ═══════════ -->
  <section class="signature-strip">
    <div class="signature-inner">
      <a href="/no-drill/" class="signature-col fade-up">
        <div class="signature-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="3" y="3" width="18" height="18" rx="1"/>
            <line x1="3" y1="9" x2="21" y2="9"/>
            <line x1="3" y1="15" x2="21" y2="15"/>
            <line x1="9" y1="3" x2="9" y2="21"/>
            <line x1="15" y1="3" x2="15" y2="21"/>
          </svg>
        </div>
        <div class="signature-text">
          <h3>No holes. No damage. No compromise.</h3>
          <p>Our no-drill system fits blinds using precision tension brackets — zero wall damage, ideal for renters, complexes and gated estates, and inside-fitted windows.</p>
        </div>
      </a>
      <a href="/motorised/" class="signature-col fade-up" style="transition-delay: 0.08s">
        <div class="signature-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="12" cy="12" r="9"/>
            <path d="M12 6v6l4 2"/>
          </svg>
        </div>
        <div class="signature-text">
          <h3>Lift, lower, live — from a button or an app.</h3>
          <p>Motorised blinds on remote, wall switch, or smart-home control. Made for large windows, hard-to-reach spots, and the way modern homes actually work.</p>
        </div>
      </a>
    </div>
  </section>

  <!-- ═══════════ ABOUT ═══════════ -->
  <section class="section about">
    <div class="section-inner">
      <div class="about-grid">
        <div class="about-images fade-up">
          <img src="/images/uploads/zebra-room.jpg" alt="Venetian blinds installation">
          <img src="/images/uploads/interior-corner.jpg" alt="Roller blinds in modern room">
          <img src="/images/uploads/honeycomb-remote.jpg" alt="Honeycomb blinds detail">
          <img src="/images/uploads/honeycomb-texture.jpg" alt="Zebra blinds in living room">
        </div>
        <div class="about-text fade-up" style="transition-delay: 0.15s">
          <div class="section-label">About Us</div>
          <h2 class="section-title">Who We Are</h2>
          <p>Dekoris is a leading, 100% Namibian provider of high-quality blinds and curtain installation services for residential, commercial, and institutional spaces.</p>
          <p>With a commitment to excellence and customer satisfaction, we offer tailored window treatment solutions to enhance the aesthetic and functional aspects of any environment.</p>
          <div class="highlight">To deliver inspiring spaces that enrich lives, blending timeless design with a modern Namibian spirit.</div>
          <a href="/about/" class="btn btn-gold" style="margin-top: 8px;">Our Story</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ VALUE PROPS ═══════════ -->
  <section class="values">
    <div class="values-inner">
      <div class="value-item fade-up">
        <div class="value-icon">
          <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        </div>
        <div class="value-title">Quality Products</div>
        <div class="value-desc">Premium materials from trusted brands.</div>
      </div>
      <div class="value-item fade-up" style="transition-delay: 0.1s">
        <div class="value-icon">
          <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        </div>
        <div class="value-title">Exceptional Service</div>
        <div class="value-desc">From consultation to aftercare.</div>
      </div>
      <div class="value-item fade-up" style="transition-delay: 0.2s">
        <div class="value-icon">
          <svg viewBox="0 0 24 24"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
        </div>
        <div class="value-title">Competitive Pricing</div>
        <div class="value-desc">Value without compromise.</div>
