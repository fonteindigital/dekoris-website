  <!-- ═══════════ HERO ═══════════ -->
  <section class="hero">
    <div class="hero-image"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <div class="hero-label">Domestic & Professional Interiors</div>
      <h1>Crafting Beautiful Spaces</h1>
      <p>Blinds, curtains, and décor that elevate the beauty of your home and office. Proudly Namibian, 100% female-owned.</p>
      <div class="hero-buttons">
        <a href="/quote/" class="btn btn-gold">Request a Quote</a>
        <a href="/about/" class="btn btn-outline">Learn More</a>
      </div>
    </div>
  </section>

  <!-- ═══════════ SIGNATURE FEATURES (Slice 12) ═══════════ -->
  <section class="signature-strip">
    <div class="signature-inner">
      <a href="/no-drill/" class="signature-col fade-up">
        <div class="signature-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="3" y="3" width="18" height="18" rx="1"/>
            <line x1="3" y1="9" x2="21" y2="9"/>
            <line x1="3" y1="15" x2="21" y2="15"/>
            <line x1="9" y1="3" x2="9" y2="21"/>
            <line x1="15" y1="3" x2="15" y2="21"/>
          </svg>
        </div>
        <div class="signature-text">
          <div class="section-label">Signature Installation</div>
          <h3>No holes. No damage. No compromise.</h3>
          <p>Our no-drill system fits blinds using precision tension brackets — zero wall damage, ideal for renters, complexes, and aluminium-framed windows.</p>
          <span class="signature-link">Learn more →</span>
        </div>
      </a>
      <a href="/motorised/" class="signature-col fade-up" style="transition-delay: 0.08s">
        <div class="signature-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="12" cy="12" r="9"/>
            <path d="M12 6v6l4 2"/>
          </svg>
        </div>
        <div class="signature-text">
          <div class="section-label">Automated Living</div>
          <h3>Lift, lower, live — from a button or an app.</h3>
          <p>Motorised blinds on remote, wall switch, or smart-home control. Made for large windows, hard-to-reach spots, and the way modern homes actually work.</p>
          <span class="signature-link">Learn more →</span>
        </div>
      </a>
    </div>
  </section>

