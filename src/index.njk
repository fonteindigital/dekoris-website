  <!-- ═══════════ PRODUCTS (CMS-driven, mirrors /shop/ cards) ═══════════ -->
  <style>
    /* Editorial cards — identical treatment to /shop/ so the two grids match */
    .home-shop-grid {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 40px 28px; margin-top: 8px;
    }
    .ed-card { display: block; text-align: center; }
    .ed-card .ed-media { position: relative; overflow: hidden; }
    .ed-card .ed-media img {
      width: 100%; height: 320px; object-fit: cover; display: block;
      transition: transform 0.55s ease;
    }
    .ed-card:hover .ed-media img { transform: scale(1.04); }
    .ed-quick {
      position: absolute; left: 0; right: 0; bottom: -46px;
      background: rgba(84,84,84,0.92); color: var(--white);
      font-size: 11px; letter-spacing: 2px; text-transform: uppercase;
      padding: 13px; transition: bottom 0.25s ease;
    }
    .ed-card:hover .ed-quick { bottom: 0; }
    @media (hover: none) {
      .ed-quick { bottom: 0; }
    }
    .ed-title {
      font-size: 12.5px; letter-spacing: 2.5px; text-transform: uppercase;
      color: var(--text-dark); font-weight: 600; margin: 18px 0 6px;
    }
    .ed-price { font-size: 13.5px; color: var(--text-light); }
    .ed-dots { display: flex; justify-content: center; gap: 5px; margin-top: 10px; min-height: 13px; }
    .ed-dots i {
      width: 13px; height: 13px; border-radius: 50%;
      box-shadow: 0 0 0 1px rgba(0,0,0,0.12); display: inline-block;
    }
    .ed-dots em { font-style: normal; font-size: 11px; color: var(--text-light); line-height: 13px; }
    .ed-badges { margin-top: 8px; }
    .ed-badges span {
      font-size: 9px; letter-spacing: 1.2px; text-transform: uppercase;
      color: var(--gold-dark); border: 1px solid var(--gold-light, #d8cdb6);
      border-radius: 2px; padding: 2px 8px; margin: 0 2px;
    }
    @media (max-width: 1024px) {
      .home-shop-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 640px) {
      .home-shop-grid { grid-template-columns: 1fr; }
      .ed-card .ed-media img { height: 280px; }
    }
  </style>
  <section class="section products">
    <div class="section-inner">
      <div class="products-header">
        <div>
          <div class="section-label fade-up">Our Products</div>
          <h2 class="section-title fade-up" style="transition-delay: 0.1s">Explore Our Range</h2>
        </div>
        <a href="/shop/" class="btn btn-gold fade-up" style="transition-delay: 0.2s; flex-shrink: 0;">View All Products</a>
      </div>
      <div class="home-shop-grid">
        {% for product in collections.products %}
        <a class="ed-card fade-up" href="/shop/{{ product.data.slug }}/" style="transition-delay: {{ loop.index0 * 0.05 }}s">
          <div class="ed-media">
            <img src="{{ product.data.image }}" alt="{{ product.data.title }}" loading="lazy">
            <div class="ed-quick">Choose Options</div>
          </div>
          <div class="ed-title">{{ product.data.title }}</div>
          {% if product.data.priceNote %}
          <div class="ed-price">{{ product.data.priceNote }}</div>
          {% else %}
          <div class="ed-price">from N${{ product.data.price | commaNumber }}</div>
          {% endif %}
          <div class="ed-dots">
            {% if product.data.fabricTypes %}
              {% for c in product.data.fabricTypes[0].colours %}
                {% if loop.index <= 5 %}<i style="background: {{ c.hex }}"></i>{% endif %}
              {% endfor %}
              {% set total = 0 %}
              {% for ft in product.data.fabricTypes %}{% set total = total + ft.colours.length %}{% endfor %}
              {% if total > 5 %}<em>+{{ total - 5 }}</em>{% endif %}
            {% endif %}
          </div>
          {% if product.data.slug != "curtains" %}
          <div class="ed-badges">
            <span>No-Drill</span>
            {% if product.data.motorised %}<span>Motorised</span>{% endif %}
          </div>
          {% endif %}
        </a>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- ═══════════ SERVICES ═══════════ -->
  <section class="section services">
    <div class="section-inner">
      <div class="section-label fade-up">Our Services</div>
      <h2 class="section-title fade-up" style="transition-delay: 0.1s">Explore Our Offerings</h2>
      <p class="section-subtitle fade-up" style="transition-delay: 0.15s">From concept to completion, we deliver tailored solutions for every space.</p>
      <div class="services-grid">
        <div class="service-card fade-up">
          <img src="/images/uploads/interior-corner.jpg" alt="Residential Installations">
          <div class="service-overlay">
            <div class="service-card-title">Residential Installations</div>
            <div class="service-card-desc">Custom blinds and curtains for all living spaces, with both manual and motorised options.</div>
          </div>
        </div>
        <div class="service-card fade-up" style="transition-delay: 0.1s">
          <img src="https://static.wixstatic.com/media/11062b_b2a88fae29a24406aee5e162858814af~mv2.jpg/v1/fill/w_800,h_900,al_c,q_80,enc_avif,quality_auto/Business%20Meeting.jpg" alt="Commercial Installations">
          <div class="service-overlay">
            <div class="service-card-title">Commercial Installations</div>
            <div class="service-card-desc">Window treatment solutions for offices, conference rooms, and common areas, focused on light control, privacy, and energy efficiency.</div>
          </div>
        </div>
        <div class="service-card fade-up" style="transition-delay: 0.2s">
          <img src="/images/uploads/roman-blinds-detail.jpg" alt="Healthcare Facilities">
          <div class="service-overlay">
            <div class="service-card-title">Healthcare Facilities</div>
            <div class="service-card-desc">Specialised blinds and curtains using anti-microbial, easy-to-clean materials that comply with healthcare standards.</div>
          </div>
        </div>
      </div>
    </div>
  </section>

