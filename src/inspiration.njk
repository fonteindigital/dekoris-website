---
layout: base.njk
pageTitle: "Inspiration — Dekoris"
pageDescription: "Ideas, tips, and trends for window treatments and interior style in Namibia."
activePage: inspiration
permalink: /inspiration/
---
  <style>
    .blog-filters {
      display: flex; gap: 8px; justify-content: center;
      flex-wrap: wrap; padding: 32px 40px;
      background: var(--white); border-bottom: 1px solid var(--cream-dark);
    }
    .blog-filter {
      padding: 8px 20px; border-radius: 24px; border: 1.5px solid var(--cream-dark);
      background: var(--white); font-family: var(--font-body);
      font-size: 13px; color: var(--text-body); cursor: pointer;
      transition: all 0.2s; font-weight: 500;
    }
    .blog-filter:hover { border-color: var(--charcoal); color: var(--charcoal); }
    .blog-filter.active {
      background: var(--charcoal); color: var(--white); border-color: var(--charcoal);
    }

    .blog-section { background: var(--cream); padding: 56px 40px 80px; }

    .blog-grid {
      max-width: 1180px; margin: 0 auto;
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;
    }
    .blog-card {
      display: block; text-decoration: none; color: inherit;
      background: var(--white); border-radius: 8px; overflow: hidden;
      transition: transform 0.3s, box-shadow 0.3s;
    }
    .blog-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    }
    .blog-card-image { height: 220px; overflow: hidden; }
    .blog-card-image img {
      width: 100%; height: 100%; object-fit: cover;
      transition: transform 0.6s;
    }
    .blog-card:hover .blog-card-image img { transform: scale(1.05); }
    .blog-card-content { padding: 24px; }
    .blog-card-tag {
      font-family: var(--font-body); font-size: 10px;
      letter-spacing: 1.8px; text-transform: uppercase;
      color: var(--gold); font-weight: 500; margin-bottom: 10px;
    }
    .blog-card-title {
      font-family: var(--font-heading); font-size: 19px;
      font-weight: 500; color: var(--text-dark);
      line-height: 1.3; margin-bottom: 10px;
    }
    .blog-card-excerpt {
      font-size: 14px; color: var(--text-body);
      line-height: 1.6; margin-bottom: 14px;
    }
    .blog-card-link {
      font-size: 12px; color: var(--text-dark);
      letter-spacing: 1px; text-transform: uppercase;
      font-weight: 500; display: inline-flex; align-items: center; gap: 6px;
    }
    .blog-card-link svg { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 2; transition: transform 0.3s; }
    .blog-card:hover .blog-card-link svg { transform: translateX(4px); }
    .blog-card.hidden { display: none; }

    .blog-newsletter {
      background: var(--grey-soft); color: var(--text-dark);
      padding: 64px 40px; text-align: center;
    }
    .blog-newsletter h2 {
      font-family: var(--font-heading); font-size: 28px;
      font-weight: 500; color: var(--text-dark); margin-bottom: 12px;
    }
    .blog-newsletter p {
      color: var(--text-body); margin-bottom: 24px;
      max-width: 520px; margin-left: auto; margin-right: auto;
    }
    .blog-newsletter-form {
      max-width: 480px; margin: 0 auto;
      display: flex; gap: 8px;
    }
    .blog-newsletter-form input {
      flex: 1; padding: 14px 18px;
      border: 1.5px solid var(--cream-dark);
      background: var(--white);
      color: var(--text-dark); border-radius: 6px; font-size: 14px;
      font-family: var(--font-body); outline: none;
    }
    .blog-newsletter-form input:focus { border-color: var(--gold); }
    .blog-newsletter-form button {
      padding: 14px 28px; background: var(--charcoal); color: var(--white);
      border: none; border-radius: 6px; font-size: 13px;
      letter-spacing: 1px; text-transform: uppercase; font-weight: 500;
      cursor: pointer;
    }
    .blog-newsletter-form button:hover { background: var(--charcoal-deep); }

    @media (max-width: 900px) {
      .blog-grid { grid-template-columns: 1fr; }
      .blog-section { padding: 40px 24px 64px; }
      .blog-newsletter { padding: 48px 24px; }
      .blog-newsletter-form { flex-direction: column; }
    }
  </style>

  <div class="page-hero">
    <div class="section-label">Blog</div>
    <h1>Inspiration</h1>
    <p>Ideas, tips, and trends to help you create beautiful spaces.</p>
  </div>

  <div class="blog-filters">
    <button class="blog-filter active" data-filter="all">All</button>
    <button class="blog-filter" data-filter="Tips & Guides">Tips & Guides</button>
    <button class="blog-filter" data-filter="Trends">Trends</button>
    <button class="blog-filter" data-filter="Product Spotlights">Product Spotlights</button>
  </div>

  <section class="blog-section">
    <div class="blog-grid">
      {% for post in collections.blog %}
        <a class="blog-card fade-up" href="/inspiration/{{ post.data.slug }}/" data-category="{{ post.data.category }}" style="transition-delay: {{ loop.index0 * 0.05 }}s">
          <div class="blog-card-image">
            <img src="{{ post.data.image }}" alt="{{ post.data.title }}">
          </div>
          <div class="blog-card-content">
            <div class="blog-card-tag">{{ post.data.category }}</div>
            <h3 class="blog-card-title">{{ post.data.title }}</h3>
            <p class="blog-card-excerpt">{{ post.data.excerpt }}</p>
            <span class="blog-card-link">Read More <svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
          </div>
        </a>
      {% endfor %}
    </div>
  </section>

  <section class="blog-newsletter">
    <h2>Get Inspiration Delivered</h2>
    <p>Subscribe for the latest ideas, tips, and trends straight to your inbox.</p>
    <form class="blog-newsletter-form" onsubmit="return false;">
      <input type="email" placeholder="Your email address" required>
      <button type="submit">Subscribe</button>
    </form>
  </section>

  <script>
    (function() {
      const filters = document.querySelectorAll(".blog-filter");
      const cards = document.querySelectorAll(".blog-card");
      filters.forEach(btn => {
        btn.addEventListener("click", function() {
          filters.forEach(b => b.classList.remove("active"));
          btn.classList.add("active");
          const f = btn.dataset.filter;
          cards.forEach(c => {
            const cat = c.dataset.category;
            c.classList.toggle("hidden", f !== "all" && cat !== f);
          });
        });
      });
    })();
  </script>
