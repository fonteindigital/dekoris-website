---
layout: base.njk
pagination:
  data: collections.blog
  size: 1
  alias: post
permalink: "/inspiration/{{ post.data.slug }}/"
eleventyComputed:
  pageTitle: "{{ post.data.title }} — Dekoris"
  pageDescription: "{{ post.data.excerpt }}"
  activePage: inspiration
---
  <style>
    .post-hero {
      margin-top: 80px; padding: 56px 40px 32px;
      max-width: 820px; margin-left: auto; margin-right: auto;
    }
    .post-back {
      font-size: 13px; color: var(--text-light);
      letter-spacing: 0.5px; display: inline-block; margin-bottom: 24px;
    }
    .post-back:hover { color: var(--gold); }
    .post-category {
      font-family: var(--font-body); font-size: 11px;
      letter-spacing: 2px; text-transform: uppercase;
      color: var(--gold); font-weight: 500; margin-bottom: 12px;
    }
    .post-title {
      font-family: var(--font-heading);
      font-size: clamp(32px, 4.5vw, 44px);
      font-weight: 500; color: var(--text-dark);
      line-height: 1.15; margin-bottom: 16px;
    }
    .post-meta {
      font-size: 13px; color: var(--text-light); margin-bottom: 24px;
    }
    .post-meta span + span::before { content: " · "; }

    .post-cover {
      width: 100%; max-width: 1100px; margin: 0 auto 48px;
      border-radius: 12px; overflow: hidden;
      aspect-ratio: 16 / 9;
    }
    .post-cover img { width: 100%; height: 100%; object-fit: cover; }

    .post-body {
      max-width: 720px; margin: 0 auto 80px;
      padding: 0 40px;
      font-family: var(--font-body); font-size: 17px;
      line-height: 1.75; color: var(--text-body);
    }
    .post-body p { margin-bottom: 20px; }
    .post-body h2 {
      font-family: var(--font-heading);
      font-size: 22px; font-weight: 500;
      color: var(--text-dark); margin: 40px 0 16px;
    }
    .post-body h3 {
      font-family: var(--font-heading);
      font-size: 18px; font-weight: 500;
      color: var(--text-dark); margin: 28px 0 12px;
    }
    .post-body a {
      color: var(--text-dark); border-bottom: 1px solid var(--gold);
    }

    .post-cta {
      background: var(--cream); padding: 56px 40px;
      text-align: center;
    }
    .post-cta h3 {
      font-family: var(--font-heading); font-size: 24px;
      font-weight: 500; color: var(--text-dark); margin-bottom: 12px;
    }
    .post-cta p {
      font-size: 15px; color: var(--text-body);
      max-width: 540px; margin: 0 auto 20px;
    }

    @media (max-width: 720px) {
      .post-hero { padding: 32px 24px 16px; }
      .post-body { padding: 0 24px; font-size: 16px; }
      .post-cta { padding: 40px 24px; }
    }
  </style>

  <section class="post-hero">
    <a href="/inspiration/" class="post-back">← Back to Inspiration</a>
    <div class="post-category">{{ post.data.category }}</div>
    <h1 class="post-title">{{ post.data.title }}</h1>
    <div class="post-meta">
      <span>{{ post.data.date | date('MMMM YYYY') }}</span>
      {% if post.data.readTime %}<span>{{ post.data.readTime }}</span>{% endif %}
    </div>
  </section>

  {% if post.data.image %}
  <div class="post-cover">
    <img src="{{ post.data.image }}" alt="{{ post.data.title }}">
  </div>
  {% endif %}

  <article class="post-body">
    {{ content | safe }}
  </article>

  <section class="post-cta">
    <h3>Considering a project of your own?</h3>
    <p>Stella visits, measures, and emails a fully-itemised quote within a few working days.</p>
    <a href="/quote/" class="btn btn-gold">Request a Quote</a>
  </section>
